{
  "name": "frontier",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop app for learning toward goals at the edge of what you know.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "seed": "tsx scripts/seed.ts",
    "live:connection": "tsx scripts/live-connection.ts",
    "live:tools": "tsx scripts/live-tools.ts",
    "live:ingest": "tsx scripts/live-ingest.ts",
    "live:session": "tsx scripts/live-session.ts",
    "live:compare": "tsx scripts/live-compare.ts",
    "live:cards": "tsx scripts/live-cards.ts",
    "live:link": "tsx scripts/live-link.ts",
    "live:embed": "tsx scripts/live-embed.ts",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "check:licenses": "tsx scripts/check-licenses.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "d3-force": "^3.0.0",
    "katex": "^0.16.22",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.69.0",
    "mermaid": "11.17.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "file:vendor/sharp-0.35.5.tgz",
    "ts-fsrs": "^5.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
